# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.config/zsh/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Prevent p10k from running the configuration wizard every reload
export POWERLEVEL9K_CONFIG_FILE=~/.config/zsh/.p10k.zsh

ZSH_THEME="powerlevel10k/powerlevel10k"
DISABLE_AUTO_UPDATE="true"
OMZ_LAZY_LOAD=true

{{ if eq .chezmoi.os "darwin" -}}
# Load Homebrew environment on macOS
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- end }}

# fpath setup (must run BEFORE oh-my-zsh runs compinit)
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src

# Oh My Zsh Plugins
plugins=(
  mise
  aliases
  ansible
  {{- if eq .chezmoi.os "darwin" }}
  brew
  {{- end }}
  bun
  chezmoi
  colored-man-pages
  copyfile
  copypath
  genpass
  git
  opentofu
  pip
  sudo
  uv
  vscode
  zsh-autosuggestions
  zsh-interactive-cd
  {{- if eq .chezmoi.os "linux" }}
  archlinux
  systemd
  {{- end }}
)

# Load Oh My Zsh Core
source $OMZSH/oh-my-zsh.sh

# Load modular conf.d fragments (aliases, eza config, compdef, functions)
for _file in "${ZDOTDIR:-$HOME/.config/zsh}"/conf.d/*.zsh(N); do
  source "$_file"
done
unset _file
